PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/snapchi
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=

RESEND_API_KEY=
# Domain test của Resend chỉ gửi được tới email chủ tài khoản
MAIL_FROM=onboarding@resend.dev

# Tuỳ chọn: chỉ bật nếu lỗi querySrv ECONNREFUSED
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Bật (true) sau khi Resend đã verify domain riêng; domain test chỉ gửi được tới email chủ tài khoản
REQUIRE_EMAIL_VERIFICATION=false
